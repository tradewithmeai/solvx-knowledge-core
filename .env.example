# Data directories
SOLVX_DATA_DIR=./data
SOLVX_DB_PATH=./data/solvx.db

# Embedding provider: openai, cohere, voyage, local
EMBED_PROVIDER=local

# API Keys (only needed if using non-local providers)
OPENAI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# Claude API (required for chat and RAG)
CLAUDE_API_KEY=

# Cost controls
MAX_EMBED_TOKENS_PER_DAY=1000000
MAX_CHAT_TOKENS_PER_DAY=500000

# Chunking parameters
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP=200

# Indexing
MAX_EMBED_WORKERS=4
EMBED_BATCH_SIZE=64

# Search
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
ENABLE_RERANK=true

# Server
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=INFO

# Optional: Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: Security
REDACT_BEFORE_EMBED=false
ENABLE_ENCRYPTION=false
ENCRYPTION_KEY=

# Optional: Advanced
ENABLE_OCR=true
QUERY_EXPANSION=true
WEEKLY_DIGEST_ENABLED=false
REFLECTION_ENABLED=false
